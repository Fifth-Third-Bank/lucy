{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "portal.example.invalid",
  "Jwt": {
    "Authority": "https://auth.example.invalid/realms/demo",
    "Audience": "portal-bff"
  },
  "LedgerApi": {
    "BaseUrl": "https://ledger-api.internal.example.invalid/"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 1048576,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "HealthChecks": {
    "Path": "/healthz"
  },
  "Telemetry": {
    "ServiceName": "portal-bff",
    "Environment": "fixture",
    "SampleRatio": 0.1
  }
}
