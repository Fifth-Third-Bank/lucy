# frozen_string_literal: true

# batch-worker: scheduled batch intake (fixture estate).
# Never bundled or run; versions are pinned for reproducible test
# snapshots, not for deployment.

source "https://rubygems.org"

ruby "3.3.1"

# HTTP surface
gem "sinatra", "~> 4.0"
gem "puma", "~> 6.4"
gem "rackup", "~> 2.1"

# Auth: RS256 verification against the demo realm
gem "jwt", "~> 2.8"

# Storage: PostgreSQL with parameterized queries only
gem "pg", "~> 1.5"

# Tooling
gem "rake", "~> 13.2"

group :development do
  gem "rubocop", "~> 1.63", require: false
end

group :test do
  gem "rspec", "~> 3.13"
  gem "rack-test", "~> 2.1"
end
